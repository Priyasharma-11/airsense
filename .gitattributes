# Normalise text files to LF in the repository and working tree, on every OS.
# Shell scripts and Dockerfiles must stay LF or Linux containers fail to start.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary artefacts - never touch
*.pkl binary
*.parquet binary
*.png binary
*.jpg binary
*.ico binary
*.gz binary
*.db binary
