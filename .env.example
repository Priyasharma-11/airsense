# ---- AirSense environment (copy to .env and adjust). NEVER commit a real .env ----
AIRSENSE_ENV=development
# SQLite for local dev; PostgreSQL+PostGIS in Docker/production:
# AIRSENSE_DATABASE_URL=postgresql+psycopg://airsense:airsense@localhost:5432/airsense
AIRSENSE_SECRET_KEY=change-me-to-a-64-char-random-string
AIRSENSE_CORS_ORIGINS=["http://localhost:3000"]
AIRSENSE_FRONTEND_URL=http://localhost:3000
AIRSENSE_ENABLE_SCHEDULER=false
# Optional: OpenAQ v3 API key (station discovery via API instead of the public archive)
# OPENAQ_API_KEY=
# Optional SMTP for password-reset / alert e-mails
# AIRSENSE_SMTP_HOST=
# AIRSENSE_SMTP_USER=
# AIRSENSE_SMTP_PASSWORD=

# ---- Local development test accounts (created with `python -m airsense.app.cli create-user`) ----
# These exist only in your local SQLite database; never use them in production.
